# AgentTrace Secrets Configuration (Example Template)
# Copy this file to .secrets/agenttrace.env or set these environment variables.

# PC-2 Hermes Worker Token (for authenticating upstream requests to PC-2)
WORKER_HERMES_KEY=replace-with-worker-bearer-token
WORKER_NODE_URL=http://127.0.0.1:8642

# Optional Gateway Ingest Token (when set, clients must send X-AgentTrace-Token or Bearer)
# AGENTTRACE_TOKEN=replace-with-cluster-shared-secret

# Upstream Allowlist (comma-separated allowed upstream hosts/URLs to prevent SSRF)
UPSTREAM_ALLOWLIST=http://127.0.0.1:11434,http://localhost:11434,http://127.0.0.1:8642,http://localhost:8642
# For a remote worker, set WORKER_NODE_URL to its endpoint and add that exact URL to this allowlist.
